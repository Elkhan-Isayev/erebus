{
  "name": "erebus",
  "productName": "Erebus",
  "version": "0.1.0",
  "description": "A fast, cross-platform desktop client for Apache Kafka \u2014 browse, produce, consume and administer your clusters.",
  "author": {
    "name": "Elkhan Isayev",
    "email": "is.elxan@gmail.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Elkhan-Isayev/erebus",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elkhan-Isayev/erebus.git"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-main.mjs --watch --dev",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icon": "node scripts/gen-icon.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "node scripts/gen-icon.mjs",
    "mcp": "npm run build && electron . --mcp"
  },
  "dependencies": {
    "avsc": "^5.7.7",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.7",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
